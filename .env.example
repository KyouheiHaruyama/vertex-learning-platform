# Canonical list of environment variables. Values live in web/.env.local and
# studio/.env, which are git-ignored. Never commit real values.

# --- web (Next.js) ---------------------------------------------------------
# Clerk — publishable key is safe in the browser, secret key is server only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Sanity — project id, dataset and API version are public identifiers.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-27
# Viewer token for the private dataset. Server only — never NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=

# --- studio (Sanity) -------------------------------------------------------
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=
